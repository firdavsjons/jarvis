# Скопируйте в .env и впишите ключи. Пустые значения — берутся значения по умолчанию из кода.
# Порядок провайдеров: при ошибке или почти исчерпанном лимите — следующий
LLM_PROVIDERS=gemini,groq,local

# Gemini (ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_DAILY_LIMIT=200
GEMINI_TOOLS=true

# Groq (ключ: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DAILY_LIMIT=800
GROQ_TOOLS=true

# Локальная модель в LM Studio (ключ не нужен, лимитов нет)
LOCAL_MODEL=google/gemma-3-4b
LOCAL_BASE_URL=http://localhost:1234/v1
# Gemma 4B без tool calling — старый режим JSON в тексте; таймаут больше, чем у облачных (15 с)
LOCAL_TOOLS=false
LOCAL_TIMEOUT=45
