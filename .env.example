# Скопируйте в .env и впишите ключи. Пустые значения — берутся значения по умолчанию из кода.
# Порядок провайдеров: при ошибке или почти исчерпанном лимите — следующий
# Локальная модель (LM Studio) выключена по умолчанию; включить: LLM_PROVIDERS=gemini,groq,local
LLM_PROVIDERS=gemini,groq
# После 3 ответов 429 (лимит) подряд за 10 минут провайдер пропускается на столько минут (иначе — 60 с)
LLM_RATE_LIMIT_PAUSE_MIN=15

# Gemini (ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Порог для заранее переключения (90%). Реальный дневной лимит вашего ключа смотрите в Google AI Studio → Rate limits
GEMINI_DAILY_LIMIT=200
# Токенов в минуту (оценка запроса: символы / 3,5): на 90% провайдер пропускается. Смотрите Google AI Studio → Rate limits
GEMINI_TPM_LIMIT=200000
GEMINI_TOOLS=true

# Groq (ключ: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DAILY_LIMIT=800
# Токенов в минуту на бесплатном тарифе мало; реальное значение — console.groq.com → Limits
GROQ_TPM_LIMIT=8000
GROQ_TOOLS=true

# Локальная модель в LM Studio (ключ не нужен, лимитов нет)
LOCAL_MODEL=google/gemma-3-4b
LOCAL_BASE_URL=http://localhost:1234/v1
# Gemma 4B без tool calling — старый режим JSON в тексте; таймаут больше, чем у облачных (15 с)
LOCAL_TOOLS=false
LOCAL_TIMEOUT=45

# Город для погоды по умолчанию (Open-Meteo, без ключа)
DEFAULT_CITY=Душанбе
# Поисковик ddgs для web_search и для новостей (выбраны живым замером: самые быстрые из рабочих)
SEARCH_BACKEND=duckduckgo
NEWS_BACKEND=bing
# Контакт в User-Agent при чтении страниц (Wikipedia и др. без него отвечают 403). Пусто — не отправлять
PAGE_CONTACT=

# Распознавание речи: пауза (с), после которой фраза считается законченной (0.5–5)
SPEECH_PAUSE=1.2
# Пауза (с) после окончания озвучки перед началом прослушивания: микрофон не ловит хвост речи ассистента (0–5)
SPEECH_TAIL_PAUSE=0.8

# Telegram: как ставится курсор в поле ввода. reopen (по умолчанию) — чат открывается по ссылке дважды подряд (диагностика
# показала: первое открытие курсор не ставит, второе ставит); direct — одно открытие (прежнее поведение).
# Другие значения не поддерживаются, вместо них используется reopen.
TELEGRAM_FOCUS_MODE=reopen
# Пауза (с) после повторного открытия чата перед Cmd+V и перед Enter (0–5)
TELEGRAM_REOPEN_WAIT=1.0
# Пауза (с) после Cmd+V, прежде чем вернуть прежний буфер обмена (0–5). Проверяется: python -m core.telegram_check
TELEGRAM_PASTE_WAIT=1.0
