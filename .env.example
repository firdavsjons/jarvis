# Скопируйте в .env и впишите ключи. Пустые значения — берутся значения по умолчанию из кода.
# Порядок провайдеров: при ошибке или почти исчерпанном лимите — следующий
# Локальная модель (LM Studio) выключена по умолчанию; включить: LLM_PROVIDERS=gemini,groq,local
LLM_PROVIDERS=gemini,groq
# После 3 ответов 429 (лимит) подряд за 10 минут провайдер пропускается на столько минут (иначе — 60 с)
LLM_RATE_LIMIT_PAUSE_MIN=15

# Gemini (ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Порог для заранее переключения (90%). Реальный дневной лимит вашего ключа смотрите в Google AI Studio → Rate limits
GEMINI_DAILY_LIMIT=200
# Токенов в минуту (оценка запроса: символы / 3,5): на 90% провайдер пропускается. Смотрите Google AI Studio → Rate limits
GEMINI_TPM_LIMIT=200000
GEMINI_TOOLS=true

# Groq (ключ: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DAILY_LIMIT=800
# Токенов в минуту на бесплатном тарифе мало; реальное значение — console.groq.com → Limits
GROQ_TPM_LIMIT=8000
GROQ_TOOLS=true

# Локальная модель в LM Studio (ключ не нужен, лимитов нет)
LOCAL_MODEL=google/gemma-3-4b
LOCAL_BASE_URL=http://localhost:1234/v1
# Gemma 4B без tool calling — старый режим JSON в тексте; таймаут больше, чем у облачных (15 с)
LOCAL_TOOLS=false
LOCAL_TIMEOUT=45

# Город для погоды по умолчанию (Open-Meteo, без ключа)
DEFAULT_CITY=Душанбе
# Поисковик ddgs для web_search и для новостей (выбраны живым замером: самые быстрые из рабочих)
SEARCH_BACKEND=duckduckgo
NEWS_BACKEND=bing
# Контакт в User-Agent при чтении страниц (Wikipedia и др. без него отвечают 403). Пусто — не отправлять
PAGE_CONTACT=

# Распознавание речи (Этап 8.1, подробности и установка — docs/stt.md)
# Движок: whisper_cpp (локальный Whisper на whisper.cpp с Metal, по умолчанию), faster_whisper (локальный, на процессоре,
# запасной) или google (recognize_google: звук уходит в Google). Вернуться на Google — одна строка: STT_ENGINE=google
STT_ENGINE=whisper_cpp
# Откат при сбое локального движка (нет пакета или модели, ошибка, модель ещё грузится): google — одна попытка в Google
# (звук уходит в интернет) или off — звук не уходит никуда, Jarvis говорит «Не удалось распознать речь». Шум и
# галлюцинации откатом не лечатся
STT_FALLBACK=google
# Модель. Пусто — по умолчанию движка: whisper_cpp large-v3-turbo-q5_0 (файл ggml-<модель>.bin в папке моделей),
# faster_whisper small. Лёгкая модель для whisper_cpp: small-q5_1
STT_MODEL=
STT_LANGUAGE=ru
# Подсказка Whisper (initial_prompt): несколько обычных командных предложений с названиями ваших приложений и контактов
# («Джарвис, открой калькулятор. Закрой сафари. …»). on (по умолчанию) или off — подсказка вообще не передаётся. Если
# Whisper дописывает слова из подсказки к фразам, сравните: python -m core.stt.check --mic --no-prompt
STT_PROMPT=on
# Потоков процессора на распознавание: не больше половины ядер (на 8 ядрах — 4)
STT_THREADS=4
# Модель выгружается из памяти после стольких минут простоя (0 — не выгружать); следующая фраза загрузит её снова
STT_UNLOAD_MINUTES=10
# Самая длинная фраза, секунд (3–60): запись обрывается, даже если пауза не наступила (раньше было 5)
SPEECH_PHRASE_LIMIT=20
# Пауза (с), после которой фраза считается законченной (0.5–5)
SPEECH_PAUSE=1.2
# Слово-активатор «Джарвис» (Этап 8.2), только для голоса: on (по умолчанию) — Jarvis отвечает на фразы, обращённые к нему
# («Джарвис, открой калькулятор», «открой калькулятор, Джарвис»), остальную речь молча отбрасывает; off — отвечает на любую
WAKE_WORD=on
# После каждого озвученного ответа Jarvis слово не нужно столько секунд (3–30); пока Jarvis ждёт ответа на вопрос — 20 с
WAKE_WINDOW=8
# Пауза (с) после окончания озвучки перед началом прослушивания: микрофон не ловит хвост речи ассистента (0–5)
SPEECH_TAIL_PAUSE=0.8

# Telegram: как ставится курсор в поле ввода. reopen (по умолчанию) — чат открывается по ссылке дважды подряд (диагностика
# показала: первое открытие курсор не ставит, второе ставит); direct — одно открытие (прежнее поведение).
# Другие значения не поддерживаются, вместо них используется reopen.
TELEGRAM_FOCUS_MODE=reopen
# Как вставляется черновик: keycode (по умолчанию, Cmd+V по физической клавише V, не зависит от раскладки; диагностика
# 7.1.5: 3 из 3), keystroke (Cmd+V по символу «v», 2 из 3) или menu (меню «Правка / Изменить → Вставить», 3 из 3)
TELEGRAM_PASTE_METHOD=keycode
# Пауза (с) после повторного открытия чата перед Cmd+V и перед Enter (0–5)
TELEGRAM_REOPEN_WAIT=1.0
# Пауза (с) после Cmd+V, прежде чем вернуть прежний буфер обмена (0–5). Проверяется: python -m core.telegram_check
TELEGRAM_PASTE_WAIT=1.0
